# --- Supabase project settings ---
# Found under Project Settings > API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=your-project-jwt-secret

# --- Dynamic QR check-in token ---
# A long, random string. Keep this secret; do not share it with the frontend.
QR_HMAC_SECRET=replace-with-a-long-random-string
QR_TOKEN_WINDOW_SECONDS=15
QR_TOKEN_LENGTH=12
QR_TOKEN_TOLERANCE_WINDOWS=1

# --- Office Wi-Fi IP restriction ---
# Comma separated list of allowed IPv4/IPv6 addresses (the office router's
# public IP, or the addresses seen by FastAPI behind your reverse proxy).
CODINEX_OFFICE_IPS=41.210.XXX.XXX
ENFORCE_OFFICE_WIFI=true

# --- Attendance business rules ---
CODINEX_TIMEZONE=Africa/Kampala
PRESENT_CUTOFF_TIME=09:00
LATE_CUTOFF_TIME=09:30

# --- Frontend ---
STUDENT_SCAN_BASE_URL=https://attendance.codinex.com/student/scan.html
ALLOWED_ORIGINS=https://attendance.codinex.com
